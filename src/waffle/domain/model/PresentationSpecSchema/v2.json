{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PresentationSpecSchema/v2",
  "title": "PresentationSpecSchema v1",
  "description": "waffle の Spec 家族のうち、プレゼンテーション層（UI層・非DDD管轄）を扱う Spec。DomainSpecSchema（DDD管轄）とは別家族。specKind=screen/flow。業務ユースケース（DomainSpecSchemaのusecase）のパラメータから導出できる項目は書かない（都度クエリで引く前提）— ここに書くのは業務ユースケースからは導けないプロダクトの意図（画面が存在する理由・業務ユースケース外の項目・振る舞いの受け入れ契約）だけ。ビジュアル（Figma等）は URL 参照のみ。",
  "x-render-target": {
    "formats": [
      "md"
    ],
    "path": {
      "screen": ".waffle/specs/{contextRef}/screen/{documentId}.md",
      "flow": ".waffle/specs/{contextRef}/flow/{documentId}.md"
    }
  },
  "x-source-target": {
    "screen": ".waffle/documents/specs/{contextRef}/screen/{documentId}.json",
    "flow": ".waffle/documents/specs/{contextRef}/flow/{documentId}.json"
  },
  "x-lifecycle": {
    "transitions": [
      {
        "from": null,
        "to": "CREATED",
        "command": "create"
      },
      {
        "from": "CREATED",
        "to": "VALIDATED",
        "command": "validate"
      },
      {
        "from": "VALIDATED",
        "to": "VALIDATED",
        "command": "validate"
      },
      {
        "from": "RENDERED",
        "to": "RENDERED",
        "command": "validate"
      },
      {
        "from": "VALIDATED",
        "to": "RENDERED",
        "command": "render"
      },
      {
        "from": "VALIDATED",
        "to": "SUPERSEDED",
        "command": "supersede"
      },
      {
        "from": "RENDERED",
        "to": "SUPERSEDED",
        "command": "supersede"
      }
    ]
  },
  "type": "object",
  "required": [
    "documentId",
    "documentType",
    "schemaRef",
    "specKind",
    "status",
    "content"
  ],
  "properties": {
    "documentId": {
      "type": "string",
      "x-prompt-write": "この Spec を一意に識別する ID を kebab-case で。screen は scr-、flow は flow- 接頭辞を推奨。例: scr-order-form"
    },
    "documentType": {
      "type": "string",
      "const": "PresentationSpec"
    },
    "schemaRef": {
      "type": "string",
      "const": "PresentationSpecSchema/v2"
    },
    "specKind": {
      "type": "string",
      "enum": [
        "screen",
        "flow"
      ],
      "x-prompt-write": "screen=1つの画面（業務ユースケース外の項目・操作・振る舞い契約を持つ）/ flow=複数の業務ユースケースにまたがる一連の体験（E2Eシナリオの合成）。迷ったら: 単体の画面の中身→screen、業務ユースケースを跨ぐ旅の意味づけ→flow。"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "VALIDATED",
        "RENDERED",
        "SUPERSEDED"
      ],
      "x-prompt-write": "作成直後は CREATED。検証通過で VALIDATED、render 済で RENDERED、後続版に置換で SUPERSEDED。"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-prompt-write": "この Spec を分類するタグ。例: [\"context:orders\"]"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "_index": {
      "description": "waffle が x-prompt-query から自動生成する。AI は直接書かない。",
      "readOnly": true,
      "type": "object",
      "properties": {
        "blocks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "blockType",
              "prompt"
            ],
            "properties": {
              "blockType": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "content": {
      "type": "object"
    },
    "documentRole": {
      "type": "string",
      "enum": [
        "instance",
        "template"
      ],
      "default": "instance",
      "description": "この文書が実体（instance）か、他プロジェクトで実体化されるための雛形（template）かを表す。documentTypeと直交する軸で、配置先の解決キーに含まれる。",
      "x-prompt-write": "この文書が、そのまま使われる実体（instance）か、他プロジェクトへ持っていって値を埋めるための雛形（template）かを選んでください。値がプレースホルダーのまま置かれ、このリポジトリでは配置先を持たない文書だけが template です。省略すると instance になります。",
      "x-prompt-query": "この文書が実体か雛形かを読みます。template の文書は配置先を持たないため、成果物が配置されていなくても未設定ではありません。逆に instance で配置先が空なら、そのdocumentTypeの宣言が漏れている合図です。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "specKind": {
            "const": "screen"
          }
        },
        "required": [
          "specKind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/ScreenContent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "specKind": {
            "const": "flow"
          }
        },
        "required": [
          "specKind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/FlowContent"
          }
        }
      }
    }
  ],
  "$defs": {
    "ScreenContent": {
      "type": "object",
      "required": [
        "title",
        "description",
        "fields",
        "actions",
        "componentAcceptanceScenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/TitleBlock"
        },
        "fields": {
          "$ref": "#/$defs/FieldsBlock"
        },
        "actions": {
          "$ref": "#/$defs/ActionsBlock"
        },
        "componentAcceptanceScenarios": {
          "$ref": "#/$defs/AcceptanceScenariosBlock"
        },
        "visualRef": {
          "$ref": "#/$defs/VisualRefBlock"
        },
        "description": {
          "$ref": "#/$defs/SummaryBlock"
        }
      }
    },
    "FlowContent": {
      "type": "object",
      "required": [
        "title",
        "description",
        "usecaseSequence"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/TitleBlock"
        },
        "usecaseSequence": {
          "$ref": "#/$defs/UsecaseSequenceBlock"
        },
        "description": {
          "$ref": "#/$defs/SummaryBlock"
        }
      }
    },
    "TitleBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title"
      ],
      "x-render-order": 0,
      "x-render-level": 1,
      "x-prompt-query": "まず何を扱う文書かを掴むために読みます。説明部分が識別子の言い換えになっていたら、何を扱うかがまだ決まっていない合図です。",
      "x-render": [],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "Title"
        },
        "title": {
          "type": "string",
          "x-prompt-write": "「業務語彙の説明：識別子」の形式で設定してください。説明部分はこの画面・フローが何を示すかを業務語彙で簡潔に表す句（この文書自身の識別子をそのまま繰り返さない）。末尾に種別を表す語（画面なら「〜を示す画面」、フローなら「〜を示すフロー」）を含め、読んだだけでこのSpecがどちらの種別かがわかるようにしてください。識別子部分はこの文書自身の識別子をそのまま使う。"
        }
      }
    },
    "SummaryBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title",
        "text"
      ],
      "x-render-order": 1,
      "x-render-level": 2,
      "x-prompt-query": "なぜこの画面が要るかを読みます。業務の操作からは導けない、製品としての意図がここにあります。業務の説明しか書かれていなければ、この画面固有の理由がまだ言えていません。",
      "x-render": [
        {
          "as": "paragraph",
          "from": "text"
        }
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "Summary"
        },
        "title": {
          "type": "string",
          "const": "概要"
        },
        "text": {
          "type": "string",
          "x-prompt-write": "この画面/フローが何のために存在するかを1〜2文で（業務ユースケースの内容の繰り返しでなく、プロダクトとしての意図）。"
        }
      }
    },
    "FieldsBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title",
        "items"
      ],
      "x-render-order": 2,
      "x-render-level": 2,
      "x-prompt-query": "業務の操作から導けない項目だけを読みます。業務の入力に対応するものはここに無いので、画面の全項目を知りたいときは業務の仕様と併せて読んでください。",
      "x-render": [
        {
          "as": "table",
          "from": "items",
          "columns": [
            {
              "field": "name",
              "header": "項目"
            },
            {
              "field": "inputType",
              "header": "種別"
            },
            {
              "field": "required",
              "header": "必須"
            },
            {
              "field": "description",
              "header": "説明（業務ユースケースにない理由）"
            }
          ]
        }
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "Fields"
        },
        "title": {
          "type": "string",
          "const": "項目（業務ユースケース外）"
        },
        "items": {
          "type": "array",
          "x-prompt-write": "業務ユースケースの入力パラメータに対応しない、UI都合の項目だけを列挙（例: パスワード確認欄・利用規約同意チェック）。業務ユースケースの入力と1対1対応する項目はここに書かない。無ければ空。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "inputType",
              "required",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "x-prompt-write": "項目名。例: パスワード（確認）"
              },
              "inputType": {
                "type": "string",
                "x-prompt-write": "入力/表示の種別。例: text / number / select / checkbox"
              },
              "required": {
                "type": "boolean",
                "x-prompt-write": "入力必須なら true。"
              },
              "description": {
                "type": "string",
                "x-prompt-write": "何のための項目か、かつ、なぜ業務ユースケースの入力ではないのかを1文で。"
              }
            }
          }
        }
      }
    },
    "ActionsBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title",
        "items"
      ],
      "x-render-order": 3,
      "x-render-level": 2,
      "x-prompt-query": "この画面から何ができるかを読みます。画面から画面への移動もここに含まれるため、遷移を探して別の表を当たる必要はありません。",
      "x-render": [
        {
          "as": "table",
          "from": "items",
          "columns": [
            {
              "field": "name",
              "header": "操作"
            },
            {
              "field": "trigger",
              "header": "契機"
            },
            {
              "field": "description",
              "header": "説明"
            },
            {
              "field": "usecaseRef",
              "header": "対応する業務ユースケース",
              "code": true
            },
            {
              "field": "leadsTo",
              "header": "遷移先",
              "code": true
            }
          ]
        }
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "Actions"
        },
        "title": {
          "type": "string",
          "const": "操作"
        },
        "items": {
          "type": "array",
          "x-prompt-write": "画面上の操作を列挙。無ければ空。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "trigger",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "x-prompt-write": "操作名。例: 注文を確定する"
              },
              "trigger": {
                "type": "string",
                "x-prompt-write": "操作の契機。例: 「確定」ボタン押下"
              },
              "description": {
                "type": "string",
                "x-prompt-write": "この操作が業務的に何をするかを1文で。例: カート内容を注文として確定する"
              },
              "usecaseRef": {
                "type": "string",
                "x-prompt-write": "この操作が対応する業務ユースケースの識別子（あれば）。例: uc-place-order。無ければ空文字。"
              },
              "leadsTo": {
                "type": "string",
                "x-prompt-write": "この操作の実行後に遷移する先の画面を指す識別子（あれば）。同じ画面に留まるなら空文字。"
              }
            }
          }
        }
      }
    },
    "VisualRefBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title",
        "url"
      ],
      "x-render-order": 5,
      "x-render-level": 2,
      "x-prompt-query": "見た目を確かめたいときに外部へ出るための入口として読みます。配置そのものはここには無いので、参照先へ当たってください。",
      "x-render": [
        {
          "as": "keyvalue",
          "pairs": [
            {
              "label": "参照先",
              "from": "url"
            },
            {
              "label": "補足",
              "from": "note"
            }
          ]
        }
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "VisualRef"
        },
        "title": {
          "type": "string",
          "const": "ビジュアル参照"
        },
        "url": {
          "type": "string",
          "x-prompt-write": "この画面のデザインを確認できる外部URL。例: https://figma.com/file/..."
        },
        "note": {
          "type": "string",
          "x-prompt-write": "補足（バージョン・参照箇所等）。無ければ空文字。"
        }
      }
    },
    "UsecaseSequenceBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title",
        "participants",
        "items"
      ],
      "x-render-order": 2,
      "x-render-level": 2,
      "x-prompt-query": "この体験がどの業務操作をどの順で繋ぐかを読みます。通し検証はこの並びに沿って各操作の受け入れ筋書きを繋いで動かします。",
      "x-render": [
        {
          "as": "sequence",
          "from": "items",
          "participantsFrom": "participants"
        },
        {
          "as": "table",
          "from": "items",
          "columns": [
            {
              "field": "from",
              "header": "主体"
            },
            {
              "field": "to",
              "header": "業務ユースケース",
              "code": true
            },
            {
              "field": "message",
              "header": "この旅における役割"
            }
          ]
        }
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "UsecaseSequence"
        },
        "title": {
          "type": "string",
          "const": "業務ユースケースの並び"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "x-prompt-write": "この旅に登場する主体を列挙。人間（顧客等）は kind=actor（棒人間アイコン）、業務ユースケースは kind=participant で宣言する。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "x-prompt-write": "識別子。人間主体は名前（例: 顧客）、業務ユースケースはその業務ユースケースを指す識別子（例: uc-place-order）。"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "actor",
                  "participant"
                ],
                "x-prompt-write": "人間の主体なら actor（棒人間アイコン）、業務ユースケース等のシステム側なら participant。"
              },
              "label": {
                "type": "string",
                "x-prompt-write": "表示名（任意・省略時はidそのまま）。"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "x-prompt-write": "主体（顧客等）が各業務ユースケースを時系列に呼び出す形で列挙。",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "message",
              "kind"
            ],
            "properties": {
              "from": {
                "type": "string",
                "x-prompt-write": "この旅を辿る主体（participantsで宣言したid・例: 顧客）。"
              },
              "to": {
                "type": "string",
                "x-prompt-write": "呼び出す業務ユースケースを指す識別子（participantsで宣言した識別子と同じもの・例: uc-place-order）。"
              },
              "message": {
                "type": "string",
                "x-prompt-write": "この旅の中でこの業務ユースケースが果たす役割を1文で。"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "command"
                ],
                "x-prompt-write": "常に command（業務ユースケースの実行呼び出し）。"
              }
            }
          }
        }
      }
    },
    "AcceptanceScenariosBlock": {
      "type": "object",
      "required": [
        "blockType",
        "title",
        "scenarios"
      ],
      "x-render-order": 4,
      "x-render-level": 2,
      "x-prompt-query": "画面単体の振る舞いを確かめる筋書きを読みます。業務の操作を介するものは業務側の仕様が持つため、ここに業務の判定が現れていたら置き場所が誤っています。",
      "x-render": [
        {
          "as": "paragraph",
          "heading": "背景",
          "from": "background"
        },
        {
          "as": "section",
          "from": "scenarios",
          "titleFrom": "name",
          "each": [
            {
              "as": "kvtable",
              "columns": [
                {
                  "field": "category",
                  "header": "分類"
                },
                {
                  "field": "viewpoint",
                  "header": "観点"
                }
              ]
            },
            {
              "as": "code",
              "from": "gherkin",
              "lang": "gherkin"
            }
          ]
        }
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "const": "AcceptanceScenarios"
        },
        "title": {
          "type": "string",
          "const": "コンポーネント受け入れシナリオ"
        },
        "background": {
          "type": "string",
          "x-prompt-write": "複数シナリオ共通の前提。無ければ空文字。"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "x-prompt-write": "1シナリオ1要素で列挙。業務ユースケースを呼ばない画面単体の振る舞い（入力検証・表示条件・活性/非活性等）を検証する。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "viewpoint",
              "gherkin"
            ],
            "properties": {
              "name": {
                "type": "string",
                "x-prompt-write": "シナリオ名（概要）。"
              },
              "category": {
                "type": "string",
                "x-prompt-write": "分類: 正常系 / 異常系 / 境界値。"
              },
              "viewpoint": {
                "type": "string",
                "x-prompt-write": "観点（入力検証/表示条件/活性状態 等）＋検証の狙い。"
              },
              "gherkin": {
                "type": "string",
                "x-prompt-write": "このシナリオの Given/When/Then（Scenario: 1つ・実行可能なテストとして書き起こせる形）。ドメイン語彙で書き、実装詳細（クラス名/API/SQL/UI 操作）は書かない。"
              }
            }
          }
        }
      }
    }
  },
  "x-frontmatter": {
    "screen": {
      "id": "doc.documentId",
      "type": "doc.specKind",
      "title": "doc.content.title.title",
      "description": "doc.content.description",
      "tags": "doc.tags",
      "schemaRef": "doc.schemaRef",
      "updatedAt": "doc.updatedAt"
    },
    "flow": {
      "id": "doc.documentId",
      "type": "doc.specKind",
      "title": "doc.content.title.title",
      "description": "doc.content.description",
      "tags": "doc.tags",
      "schemaRef": "doc.schemaRef",
      "updatedAt": "doc.updatedAt"
    }
  }
}
