def sections(text: str) -> dict:
    """本文を節に切る。背骨は種類ごとに決まっているので、名前で引ける。"""
    text = re.sub(r"^---\n.*?\n---\n", "", text, flags=re.S)
    out, cur, buf = {}, None, []
    for line in text.split("\n"):
        if m := re.match(r"^## (.+)$", line):
            if cur:
                out[cur] = "\n".join(buf).strip()
            cur, buf = m.group(1).strip(), []
        elif cur:
            buf.append(line)
    if cur:
        out[cur] = "\n".join(buf).strip()
    return out


# 種類ごとに、まず見せる節（画面の主役）
LEAD_OF = {
    "選択": ["選んだもの", "落とした候補"],
    "規則": ["規則一覧"],
    "構造": ["構成要素", "依存の許可"],
    "振る舞い": ["保証する振る舞い", "保証しない振る舞い"],
}
# 末尾へ回す節
TAIL = ("適用範囲外", "委譲する判断", "出典")


def overlap_of(d: dict, docs: list[dict]) -> list[dict]:
    """条件が重なる規約。重なること自体は正常（広い条件と狭い条件）。"""
    c = dict(d["_cond"])
    out = []
    for o in docs:
        if o is d or o.get("文書の種類") == "選択":
            continue
        oc = dict(o["_cond"])
        if not c or not oc:
            out.append(o)
            continue
        shared = set(c) & set(oc)
        if shared and all(c[k] == oc[k] for k in shared):
            out.append(o)
    return out


def doc_view(d: dict, docs: list[dict] | None = None, sel: dict | None = None) -> str:
    """文書を、種類の形に合わせて組む。**マークダウンをそのまま流さない。**"""
    sec = sections(d["_text"])
    kind = d.get("文書の種類", "")
    ja0 = axis_names()
    cond = "".join(f"<span class='c'>{ja0.get(k, k)} {v}</span>" for k, v in d["_cond"]) or "<span class='c'>どこでも効く</span>"
    close = f"<a class='close' href='{q(sel or {}, id='')}' aria-label='閉じる'>×</a>" if sel is not None else ""
    head = (f"<header class='dh'>{close}<span class='badge'>{kind}</span>"
            f"<h1>{d.get('主題','')}</h1>"
            f"<p class='meta'>{cond}<span class='id'>{d.get('id','')}</span></p>"
            f"<p class='why'>{d.get('まとまる理由','')}</p></header>")
    # 段落の中に段落は置けない。<p> にすると帯だけ空で残り、本文が外へ出る
    lead = f"<div class='lead'>{md2html(sec.pop('概要', ''))}</div>" if sec.get("概要") else ""
    main = []
    for name in LEAD_OF.get(kind, []):
        if body := sec.pop(name, ""):
            main.append(f"<section class='main' id='sec-{name}'><h2>{name}</h2>{md2html(body)}</section>")
    rest = []
    for name, body in sec.items():
        if name in TAIL or not body:
            continue
        rest.append(f"<section class='sub' id='sec-{name}'><h2>{name}</h2>{md2html(body)}</section>")
    tail = []
    for name in TAIL:
        if body := sec.get(name, ""):
            tail.append(f"<section class='tail' id='sec-{name}'><h3>{name}</h3>{md2html(body)}</section>")
    stamp = f"<p class='stamp'>承認　{d.get('承認','')}</p>"
    ov = ""
    if docs is not None and kind != "選択":
        others = overlap_of(d, docs)
        if others:
            ja = axis_names()
            rows = "".join(
                f"<a class='ovr' href='{q(sel or {}, id=o['id'])}'>"
                f"<span class='t'>{o.get('主題','')}</span>"
                f"<span class='c'>{' '.join(f'{ja.get(k, k)} {v}' for k, v in o['_cond']) or 'どこでも'}</span></a>"
                for o in others)
            ov = (f"<section class='ov'><h3>条件が重なる規約　{len(others)}</h3>{rows}</section>")
    return (f"<article class='doc'>{head}{lead}{''.join(main)}{''.join(rest)}"
            f"<div class='tails'>{''.join(tail)}{stamp}</div>{ov}</article>")


MAIN_TABLE = {"規則": "規則一覧", "振る舞い": "保証する振る舞い", "構造": "依存の許可"}


def rules_of(d: dict) -> list[dict]:
    """文書が持つ決めごとを、主役の表から取り出す。"""
    sec = sections(d["_text"]).get(MAIN_TABLE.get(d.get("文書の種類", ""), ""), "")
    out = []
    for line in sec.split("\n"):
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) < 2 or not re.fullmatch(r"[A-Z]{2,4}(?:-[A-Z]+)?-\d{2}", cells[0]):
            continue
        out.append({"id": cells[0], "text": cells[1],
                    "level": cells[2] if len(cells) > 2 else "",
                    "scope": cells[3] if len(cells) > 3 else "",
                    "doc": d})
    return out


def items(doc: dict) -> int:
    """その文書が持つ決めごとの数。"""
    return len(rules_of(doc))


def terms(docs: list[dict]) -> list[str]:
    """探すときに選べるもの。**決めごとの番号だけ**を出す。

    主題は左の一覧に見えているので候補に要らない。
    本文の語を機械で拾うと、表の行見出しまで混ざって選べる数を超える。
    """
    seen: list[str] = []
    for d in docs:
        for i in sorted(set(re.findall(r"\b[A-Z]{2,4}(?:-[A-Z]+)?-\d{2}\b", d["_text"]))):
            if i not in seen:
                seen.append(i)
    return seen



def matched_in(d: dict, word: str) -> str:
    """どこで当たったか。当たった理由が見えないと、次の一手が決められない。"""
    if not word:
        return ""
    if word in str(d.get("主題", "")):
        return "主題"
    if word in str(d.get("id", "")):
        return "id"
    if re.search(rf"^\| {re.escape(word)} \|", d["_text"], re.M):
        return "決めごと"
    return "本文"


def axis_values(docs: list[dict]) -> dict[str, list[str]]:
    """文書に実際に現れる軸の値。ここに無い値は選べない。"""
    got: dict[str, set[str]] = {}
    for d in docs:
        if d.get("文書の種類") == "選択":
            for k, vs in values_of(d).items():
                got.setdefault(k, set()).update(vs)
        for k, v in d["_cond"]:
            got.setdefault(k, set()).add(v)
    return {k: sorted(v) for k, v in sorted(got.items())}


def q(sel: dict, **over) -> str:
    """いまの選び方に、変更を1つ重ねた問い合わせ文字列。"""
    cur = {k: list(v) for k, v in sel.items()}
    cur.update(over)
    parts = []
    for k, v in cur.items():
        for x in (v if isinstance(v, list) else [v]):
            if x:
                parts.append(f"{k}={x}")
    return "?" + "&".join(parts) if parts else "?"


SCOPES = {"": "すべて", "主題": "主題", "番号": "決めごとの番号", "本文": "本文"}
LAYOUTS = {"A": "一覧が主役", "B": "ペインと本文", "C": "ナビと目次"}
LAW = ("<footer class='law'>Canon　© 2026 daidaiiro　"
       "<a href='https://opensource.org/licenses/MIT'>MIT License</a></footer>")


def match(d: dict, word: str, scope: str) -> bool:
    if not word:
        return True
    if scope == "主題":
        return word in str(d.get("主題", ""))
    if scope == "番号":
        return bool(re.search(rf"^\| {re.escape(word)} \|", d["_text"], re.M))
    if scope == "本文":
        return word in d["_text"]
    return (word in d["_text"] or word in str(d.get("id", "")))


class View:
    """絞り込みの結果と、組み立てに要るものを1つにまとめる。"""

    def __init__(self, docs, sel):
        self.docs, self.sel = docs, sel
        self.av, self.ja = axis_values(docs), axis_names()
        self.picked = {k: v[0] for k, v in sel.items() if k in self.av and v and v[0]}
        self.kind = sel.get("kind", [""])[0]
        self.word = (sel.get("q", [""])[0] or "").strip()
        self.scope = sel.get("in", [""])[0]
        self.by = sel.get("by", ["種類"])[0] or "種類"
        self.layout = (sel.get("layout", ["B"])[0] or "B").upper()
        self.rules = [d for d in docs if d.get("文書の種類") != "選択"]
        self.decls = [d for d in docs if d.get("文書の種類") == "選択"]
        self.fit = self.narrow(self.picked, self.kind)
        self.n = sum(max(items(d), 1) for d in self.fit)

    def narrow(self, pk, kd):
        return [d for d in self.rules
                if (not kd or d.get("文書の種類") == kd)
                and match(d, self.word, self.scope)
                and all(pk[ck] == cv for ck, cv in d["_cond"] if ck in pk)]

    def label(self, k):
        return self.ja.get(k, k)


def header_html(v: View, extra: str = "") -> str:
    sel = v.sel
    keep = "".join(f"<input type=hidden name='{k}' value='{x[0]}'>"
                   for k, x in sel.items() if k not in ("q", "in", "id") and x and x[0])
    opts = "".join(f"<option value='{k}'{' selected' if v.scope == k else ''}>{t}</option>"
                   for k, t in SCOPES.items())
    sw = "".join(f"<a class='sw{' on' if v.layout == k else ''}' href='{q(sel, layout=k)}' "
                 f"title='{t}'>{k}</a>" for k, t in LAYOUTS.items())
    return (f"<header class='top'>{extra}{LOGO}<span class='name'>Canon</span>"
            f"<span class='sws'>{sw}</span>"
            f"<form class='search' method='get' action='/'>{keep}"
            f"<select name='in' aria-label='探す範囲'>{opts}</select>"
            f"<input name='q' value='{v.word}' placeholder='語や番号で探す' autocomplete='off' aria-label='探す語'>"
            f"<button>探す</button></form>"
            f"<a class='out' href='{q(sel, 出す='1', id='')}'>まとめて出す</a></header>")


def chips_html(v: View) -> str:
    out = []
    for k, val in v.picked.items():
        out.append(f"<a class='chip' href='{q(v.sel, **{k: ''})}'>{v.label(k)} <b>{val}</b>"
                   f"<span class='x'>×</span></a>")
    if v.kind:
        out.append(f"<a class='chip' href='{q(v.sel, kind='')}'><b>{v.kind}</b><span class='x'>×</span></a>")
    if v.word:
        out.append(f"<a class='chip' href='{q(v.sel, q='')}'>{SCOPES.get(v.scope, 'すべて')} <b>{v.word}</b>"
                   f"<span class='x'>×</span></a>")
    return "".join(out)


def facets_html(v: View, compact: bool = False) -> str:
    out = []
    for k, vs in v.av.items():
        on_here = v.picked.get(k)
        out.append(f"<div class='fh'><span>{v.label(k)}</span>"
                   + (f"<a href='{q(v.sel, **{k: ''})}'>外す</a>" if on_here else "") + "</div>")
        for val in vs:
            n = len(v.narrow({**v.picked, k: val}, v.kind))
            cls = "f on" if on_here == val else ("f zero" if n == 0 else "f")
            out.append(f"<a class='{cls}' href='{q(v.sel, **{k: ('' if on_here == val else val)})}'>"
                       f"{val}<span class='num'>{n}</span></a>")
    out.append(f"<div class='fh'><span>種類</span>"
               + (f"<a href='{q(v.sel, kind='')}'>外す</a>" if v.kind else "") + "</div>")
    for kd in KINDS[1:]:
        n = len(v.narrow(v.picked, kd))
        cls = "f on" if v.kind == kd else ("f zero" if n == 0 else "f")
        out.append(f"<a class='{cls}' href='{q(v.sel, kind=('' if v.kind == kd else kd))}'>{kd}"
                   f"<span class='num'>{n}</span></a>")
    if v.decls and not compact:
        out.append("<div class='fh'><span>宣言</span></div>")
        for d in v.decls:
            pre = {k: sorted(x)[0] for k, x in values_of(d).items() if len(x) == 1}
            out.append(f"<a class='f' href='{q({}, layout=v.layout, **pre)}'>この構成で絞る</a>")
            out.append(f"<a class='f' href='{q(v.sel, id=d['id'])}'>{d.get('主題','')}</a>")
    if v.picked or v.kind or v.word:
        out.append(f"<a class='clearall' href='{q({}, layout=v.layout)}'>すべて外す</a>")
    return "".join(out)


def dropdowns_html(v: View) -> str:
    """A 案：軸と種類を、上のドロップダウンにする。"""
    out = []
    for k, vs in v.av.items():
        cur = v.picked.get(k, "")
        opts = "".join(f"<option value='{q(v.sel, **{k: val})}'{' selected' if cur == val else ''}>{val}"
                       f"（{len(v.narrow({**v.picked, k: val}, v.kind))}）</option>" for val in vs)
        out.append(f"<select class='dd' onchange='location=this.value' aria-label='{v.label(k)}'>"
                   f"<option value='{q(v.sel, **{k: ''})}'{'' if cur else ' selected'}>{v.label(k)}</option>"
                   f"{opts}</select>")
    opts = "".join(f"<option value='{q(v.sel, kind=kd)}'{' selected' if v.kind == kd else ''}>{kd}"
                   f"（{len(v.narrow(v.picked, kd))}）</option>" for kd in KINDS[1:])
    out.append(f"<select class='dd' onchange='location=this.value' aria-label='種類'>"
               f"<option value='{q(v.sel, kind='')}'{'' if v.kind else ' selected'}>種類</option>{opts}</select>")
    for d in v.decls:
        pre = {k: sorted(x)[0] for k, x in values_of(d).items() if len(x) == 1}
        out.append(f"<a class='pill' href='{q({}, layout=v.layout, **pre)}'>この構成で絞る</a>")
    return "".join(out)


def cond_name(d: dict, v: View) -> str:
    """その規約が効く条件。軸の値の組を、そのまま名前にする。"""
    return "　".join(f"{v.label(k)} {x}" for k, x in d["_cond"]) or "どこでも効く"


def list_html(v: View, show) -> str:
    tabs = "".join(f"<a class='tab{' on' if v.by == t else ''}' href='{q(v.sel, by=t)}'>{t}でまとめる</a>"
                   for t in ("種類", "適用条件"))
    out = [f"<div class='tabs'>{tabs}<span class='tn'>決めごと {v.n}</span></div>"]

    def line(d, r, tag):
        on = " on" if show and d["id"] == show["id"] else ""
        if r is None:
            return (f"<a class='rule{on}' href='{q(v.sel, id=d['id'])}'>"
                    f"<span class='rid'>─</span><span class='rt'>{d.get('主題','')}</span>"
                    f"<span class='lv'>{tag}</span><span class='sc'></span></a>")
        lv = f"<span class='lv'>{r['level']}</span>" if r["level"] else "<span class='lv'></span>"
        return (f"<a class='rule{on}' href='{q(v.sel, id=d['id'])}'>"
                f"<span class='rid'>{r['id']}</span><span class='rt'>{r['text']}</span>"
                f"{lv}<span class='sc'>{tag}</span></a>")

    if v.by == "種類":
        groups = [(kd, [d for d in v.fit if d.get("文書の種類") == kd]) for kd in KINDS[1:]]
        tagf = lambda d: cond_name(d, v) 
    else:
        # 鍵は軸の値1つではなく、値の**組**。1つずつにすると、条件を2つ持つ
        # 規約が両方の束に出て、同じ決めごとのコピーが並ぶ
        b: dict = {}
        for d in v.fit:
            b.setdefault(cond_name(d, v), []).append(d)
        groups = sorted(b.items(), key=lambda kv: (len(kv[1][0]["_cond"]), kv[0]))
        tagf = lambda d: d.get("文書の種類", "")
    for name, group in groups:
        if not group:
            continue
        out.append(f"<div class='grp'><span class='gt'>{name}</span>"
                   f"<span class='gn'>{sum(max(items(d), 1) for d in group)}</span></div>")
        for d in group:
            rs = rules_of(d)
            if not rs:
                out.append(line(d, None, tagf(d)))
            for r in rs:
                out.append(line(d, r, tagf(d)))
    if not v.fit:
        c = chips_html(v)
        out.append("<div class='empty'><h3>該当なし</h3>"
                   + (f"<p class='dim2'>効いている絞り込み　押すと外せる</p><div class='applied'>{c}</div>" if c else "")
                   + f"<a class='back' href='{q({}, layout=v.layout)}'>すべて外す</a></div>")
    return "".join(out)


def toc_html(d: dict) -> str:
    names = [n for n in sections(d["_text"]) if n and n != "概要"]
    return ("<div class='fh'><span>この文書の中</span></div>"
            + "".join(f"<a class='f' href='#sec-{n}'>{n}</a>" for n in names))


def page(docs: list[dict], sel: dict, show: dict | None) -> str:
    v = View(docs, sel)
    chips = chips_html(v)
    applied = f"<div class='applied'>{chips or '<span class=dim2>絞り込みなし</span>'}</div>"

    if v.layout == "A":
        top = header_html(v)
        if show:
            main = (f"<main class='wide'><p class='crumb'><a class='back' href='{q(sel, id='')}'>"
                    f"← 一覧へ戻る</a></p>{doc_view(show, docs, sel)}</main>")
        else:
            main = (f"<main class='wide'><div class='ddbar'>{dropdowns_html(v)}</div>"
                    f"{applied}<div class='wlist'>{list_html(v, show)}</div></main>")
        return ("<!doctype html><meta charset='utf-8'><title>Canon</title>"
                f"<style>{STYLE}</style><div class='app layA'>{top}{main}{LAW}</div>")

    if v.layout == "C":
        top = header_html(v, f"<label for='menu' class='burger' aria-label='絞り込みの開閉'>"
                             f"<span></span><span></span><span></span></label>")
        body = (f"<nav class='facets'>{facets_html(v)}</nav>"
                f"<main class='content'>"
                + (doc_view(show, docs, sel) if show
                   else f"{applied}<div class='wlist'>{list_html(v, show)}</div>")
                + "</main>"
                + (f"<aside class='toc'>{toc_html(show)}</aside>" if show else "<aside class='toc'></aside>"))
        return ("<!doctype html><meta charset='utf-8'><title>Canon</title>"
                f"<style>{STYLE}</style><div class='app'>"
                f"<input type='checkbox' id='menu' class='menu-t'>{top}"
                f"<div class='body layC'>{body}</div>{LAW}</div>")

    # B（既定）：上に絞り込みの帯、下にペインと本文
    top = header_html(v, f"<label for='menu' class='burger' aria-label='一覧の開閉'>"
                         f"<span></span><span></span><span></span></label>")
    bar = (f"<div class='fbar'>{dropdowns_html(v)}"
           f"<span class='fsep'></span>{chips_html(v)}</div>")
    pane = f"<nav class='pane'><div class='plist'>{list_html(v, show)}</div></nav>"
    content = ("<main class='content'>"
               + (doc_view(show, docs, sel) if show else
                  f"<div class='hello'><h2>決めごとを選ぶ</h2>"
                  f"<p>上で絞り込み、左の行を押すと、ここに開く。</p>"
                  f"<p class='dim2'>いま {v.n} 件</p></div>")
               + "</main>")
    return ("<!doctype html><meta charset='utf-8'><title>Canon</title>"
            f"<style>{STYLE}</style><div class='app'>"
            f"<input type='checkbox' id='menu' class='menu-t'>{top}{bar}"
            f"<div class='body layB'>{pane}{content}</div>{LAW}</div>")



def md_bundle(fit: list[dict], cond: str) -> str:
    """出すマークダウン。落とす と同じものを作る ── 見たものと出るものを一致させる。"""
    body = [f"# 規約　{cond}", "", f"文書 {len(fit)}本 ・ 決めごと {sum(items(d) for d in fit)}件", "",
            "この写しは使い捨てである ── 正本は別にある。", ""]
    for d in fit:
        body.append(re.sub(r"^---\n.*?\n---\n", "", d["_text"], flags=re.S).strip())
        body.append("\n---\n")
    return "\n".join(body)


def export_page(fit: list[dict], cond: str, sel: dict, dest: Path, done: Path | None) -> str:
    md = md_bundle(fit, cond)
    esc = md.replace("&", "&amp;").replace("<", "&lt;")
    rows = "".join(f"<li>{d.get('主題','')}<span class='c'>{d.get('文書の種類')}</span></li>" for d in fit)
    if done:
        act = (f"<p class='done'>出しました　<code>{done}</code></p>"
               f"<p class='foot'><a class='go' href='{q(sel, 出す='')}'>一覧へ戻る</a></p>")
    else:
        act = (f"<form method='post' action='/'>"
               + "".join(f"<input type=hidden name='{k}' value='{v[0]}'>" for k, v in sel.items() if k != "出す")
               + f"<p class='foot'><span class='dim2'>出す先　<code>{dest}</code></span>"
                 f"<button class='go' type='submit'>この内容で出す</button></p></form>")
    return ("<!doctype html><meta charset='utf-8'><title>Canon　出す</title>"
            f"<style>{STYLE}</style><div class='app'>"
            f"<header class='top'>{LOGO}<span class='name'>Canon</span>"
            f"<a class='back' href='{q(sel, 出す='')}'>一覧へ戻る</a></header>"
            f"<main class='ex'><p class='sum'><span class='cond'>{cond}</span>"
            f"<span class='cnt'>文書 {len(fit)}　決めごと {sum(items(d) for d in fit)}</span></p>"
            f"<ul class='exlist'>{rows}</ul>"
            f"<h2 class='exh'>出るもの</h2><pre class='ex-md'>{esc}</pre>{act}</main></div>")


def 画面(docs, port: int, dest: str = "dist") -> int:
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    out_dir = Path(dest)

    def picked_of(sel):
        av = axis_values(docs)
        picked = {k: v[0] for k, v in sel.items() if k in av and v and v[0]}
        kind_pick = sel.get("kind", [""])[0]
        ja = axis_names()
        fit = [d for d in docs if d.get("文書の種類") != "選択"
               and (not kind_pick or d.get("文書の種類") == kind_pick)
               and all(picked[ck] == cv for ck, cv in d["_cond"] if ck in picked)]
        cond = "　".join(f"{ja.get(k, k)} {v}" for k, v in picked.items()) or "すべて"
        if kind_pick:
            cond += f"　{kind_pick}"
        return fit, cond

    class H(BaseHTTPRequestHandler):
        def _send(self, html: str):
            raw = html.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)

        def do_GET(self):
            sel = parse_qs(urlparse(self.path).query)
            if sel.get("出す"):
                fit, cond = picked_of(sel)
                return self._send(export_page(fit, cond, sel, out_dir, None))
            show = None
            if sel.get("id"):
                show = next((d for d in docs if d["id"] == sel["id"][0]), None)
            self._send(page(docs, sel, show))

        def do_POST(self):
            n = int(self.headers.get("Content-Length") or 0)
            sel = parse_qs(self.rfile.read(n).decode("utf-8"))
            fit, cond = picked_of(sel)
            out_dir.mkdir(parents=True, exist_ok=True)
            f = out_dir / "conventions.md"
            f.write_text(md_bundle(fit, cond), encoding="utf-8")
            self._send(export_page(fit, cond, sel, out_dir, f))

        def log_message(self, *a):
            pass

    decl = entry(docs)
    start = q({}, **{k: sorted(v)[0] for k, v in values_of(decl).items() if len(v) == 1})
    with ThreadingHTTPServer(("127.0.0.1", port), H) as httpd:
        print(f"開く  : http://127.0.0.1:{port}/{start}")
        print(f"出す先: {out_dir}")
        print("左で軸の値を選ぶと、条件が合う文書だけが右に出る")
        print("保存しない ── 見ているのは、そのつど描いたものである")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\n止めました")
    return 0



def 落とす(docs, dest: str, as_md: bool) -> int:
    decl = entry(docs)
    vals = values_of(decl)
    fit = [d for d in docs if d.get("文書の種類") != "選択" and fits(d, vals)]
    out = Path(dest)
    if HOME.resolve() in out.resolve().parents or out.resolve() == HOME.resolve():
        sys.exit(f"正本の中へは出さない: {out}")
    out.mkdir(parents=True, exist_ok=True)
    cond = "　".join(f"{k} = {' ・ '.join(sorted(v))}" for k, v in sorted(vals.items()))
    if as_md:
        body = [f"# {decl.get('主題','')}　の規約", "", cond, "",
                f"規約 {len(fit)}本。**この写しは使い捨てである** ── 正本は別にある。", ""]
        for d in [decl] + fit:
            body.append(re.sub(r"^---\n.*?\n---\n", "", d["_text"], flags=re.S))
            body.append("\n---\n")
        f = out / f"{decl['id']}.md"
        f.write_text("\n".join(body), encoding="utf-8")
    else:
        parts = [f"<h1>{decl.get('主題','')}　の規約</h1><p class='sum'>{cond}　規約 {len(fit)}本</p>",
                 "<p class='sum'><b>この写しは使い捨てである</b> ── 正本は別にある。</p>"]
        for d in [decl] + fit:
            parts.append(f"<hr><p class='f'><span class='k'>{d.get('文書の種類')}</span>{d['id']}</p>")
            parts.append(md2html(d["_text"]))
        f = out / f"{decl['id']}.html"
        f.write_text(f"<!doctype html><meta charset='utf-8'><title>{decl.get('主題','')}</title>"
                     f"<style>{STYLE}.wrap{{display:block}}main{{margin:0 auto}}</style>"
                     f"<main>{''.join(parts)}</main>", encoding="utf-8")
    print(f"{f} に出した（{len(fit)}本 ＋ 宣言1本）")
    print("使い捨てである ── 正本は .coding にある")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    global HOME
    if "--置き場所" in argv:
        i = argv.index("--置き場所")
        HOME = Path(argv[i + 1])
        del argv[i:i + 2]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 1
    op, *rest = argv
    if op == "--version":
        print(f"conv {VERSION}\n作った元　{BUILT_FROM}\n出した日　{BUILT_ON}\n"
              f"© 2026 daidaiiro　MIT License")
        return 0
    if op == "初期化":
        return 初期化(rest[0])
    if not HOME.is_dir():
        sys.exit(f"置き場所が無い: {HOME}\n  conv 初期化 <置き場所> で作るか、--置き場所 で指す")
    docs = load()
    if op == "一式":
        一式(docs, rest[0] if rest else None)
    elif op == "重なり":
        重なり(docs, rest)
    elif op == "差分":
        差分(docs, rest[0], rest[1] if len(rest) > 1 else None)
    elif op == "効かない":
        効かない(docs)
    elif op == "画面":
        port, dest = 8732, "dist"
        if "--port" in rest:
            port = int(rest[rest.index("--port") + 1])
        if "--出す先" in rest:
            dest = rest[rest.index("--出す先") + 1]
        return 画面(docs, port, dest)
    elif op == "落とす":
        return 落とす(docs, rest[0], "--md" in rest)
    elif op == "検査":
        return 検査(docs)
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
