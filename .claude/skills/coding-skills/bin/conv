"""宣言と規約を突き合わせ、集める・並べる・差分を出す・検査する道具。

    conv 初期化 <置き場所>         入口と規約の置き場所を作り、宣言の骨を起こす
    conv 一式 [宣言のid]           宣言に効く規約を集める（1つしか無ければ省ける）
    conv 重なり <軸=値> …          その条件と重なる規約を並べる
    conv 差分 <軸=値> [宣言のid]   その値に変えたときの入れ替わり
    conv 効かない                  どの宣言にも当たらない規約を並べる
    conv 画面 [--port 8732] [--出す先 dist]
                                   ローカルサーバーを立て、描画して見せる。保存しない
    conv 落とす <出す先> [--md]    一式を1枚にまとめて出す。使い捨て
    conv 検査                      背骨と条件の軸名を見る
    conv --version                 この道具の版

**文書は、この Skill の外に置く。**置き場所は `--置き場所` で渡すか、
環境変数 `CODING_HOME` で指す。既定は、いまのディレクトリの `.coding`。

    .coding/
      declarations/       選択（宣言）
      rules/              規則
      structures/         構造
      behaviors/          振る舞い

**フォルダは人のためのものである。**機械は前置きの「文書の種類」で判断し、
置き場所を見ない ── だから置き場所を変えても、集まり方は変わらない。

**切ってよいのは、文書がその値を1つしか持たないものだけ。**
文書の種類は1つなので切れる。軸は複数もつことがある（`language ＋ architecture`）ので、切れない。

**判断は持たない。**並べるところまでがこの道具で、
矛盾かどうか・消すかどうかは、読んで決める。

documents/ を読むだけで、書き換えない。
軸の一覧と、種類ごとの背骨は templates/ が持つ ── ここには書き写さない。
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

VERSION = "0.1.0"
BUILT_FROM = "概念実装（CodingSchema はまだ無い）"
BUILT_ON = "2026-09-10"

import os

ROOT = Path(__file__).resolve().parent.parent
TPL = ROOT / "templates"                                   # 形の定め。Skill が持つ
HOME = Path(os.environ.get("CODING_HOME", ".coding"))      # 中身。使う側が持つ

KINDS = ("選択", "規則", "構造", "振る舞い")
TEMPLATE_OF = {"選択": "declaration", "規則": "rule", "構造": "structure", "振る舞い": "behavior"}
# 人が見つけるための置き場所。機械は前置きの「文書の種類」で判断する
FOLDER_OF = {"選択": "declarations", "規則": "rules", "構造": "structures", "振る舞い": "behaviors"}
PREFIX_OF = {"選択": "declaration", "規則": "rule", "構造": "structure", "振る舞い": "behavior"}
CORE_KEYS = ("id", "文書の種類", "主題", "まとまる理由", "承認")


# ── 読む ────────────────────────────────────────────────

def axis_names() -> dict[str, str]:
    """条件に書く名 → 読むための呼び名。定めは templates/axes.md が持つ。"""
    text = (TPL / "axes.md").read_text(encoding="utf-8")
    return {k: ja for ja, k in re.findall(r"^\| (\S+) \| `(\w+)` \|", text, re.M)}


def axes() -> dict[str, bool]:
    """軸の一覧を templates/axes.md から読む。値は「複数もてるか」。"""
    text = (TPL / "axes.md").read_text(encoding="utf-8")
    names = re.findall(r"^\| \S+ \| `(\w+)` \|", text, re.M)
    # 複数もてるのは form だけ、と axes.md が書いている
    多値 = set(re.findall(r"複数行書けるのは `(\w+)` だけ", text))
    return {n: (n in 多値) for n in names}


def spine(kind: str) -> list[str]:
    """種類ごとの背骨（節の並び）を templates/ から読む。"""
    text = (TPL / f"{TEMPLATE_OF[kind]}.md").read_text(encoding="utf-8")
    return re.findall(r"^## (.+)$", text, re.M)


def front(text: str) -> dict:
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return {}
    out: dict = {}
    key = None
    for line in m.group(1).split("\n"):
        if line.startswith("  - "):
            out.setdefault(key, []).append(line[4:].strip())
        elif ":" in line:
            key, _, val = line.partition(":")
            key, val = key.strip(), val.strip()
            out[key] = val if val else []
    return out


def files() -> list[Path]:
    """入口と規約。置き場所に関わらず、すべて読む ── 判断は前置きで行う。"""
    return sorted(HOME.glob("*.md")) + sorted(HOME.glob("*/*.md"))


def load() -> list[dict]:
    docs = []
    for f in files():
        text = f.read_text(encoding="utf-8")
        fm = front(text)
        if not fm:
            continue
        fm["_path"], fm["_text"] = f, text
        fm["_sections"] = re.findall(r"^## (.+)$", text, re.M)
        cond = fm.get("適用条件") or []
        fm["_cond"] = [tuple(x.strip() for x in c.split("=", 1)) for c in cond if "=" in c]
        docs.append(fm)
    return docs


def values_of(doc: dict) -> dict[str, set[str]]:
    """宣言が持つ軸の値。機械が読む節だけを見る ── ほかの節にも値が文中に出る。"""
    m = re.search(r"## この選択がつくる適用条件\n(.*?)(?=\n## |\Z)", doc["_text"], re.S)
    got: dict[str, set[str]] = {}
    if m:
        for k, v in re.findall(r"^(\w+) = ([\w-]+)$", m.group(1), re.M):
            got.setdefault(k, set()).add(v)
    return got


def fits(doc: dict, vals: dict[str, set[str]]) -> bool:
    """条件の値をすべて持っているか。条件が空なら、どこでも効く。"""
    return all(v in vals.get(k, set()) for k, v in doc["_cond"])


def find(docs: list[dict], doc_id: str) -> dict:
    for d in docs:
        if d.get("id") == doc_id:
            return d
    sys.exit(f"{doc_id} という id の文書が無い")


# ── 出す ────────────────────────────────────────────────

def entry(docs: list[dict], doc_id: str | None = None) -> dict:
    """宣言を、置き場所ではなく**種類**で見つける。"""
    decls = [d for d in docs if d.get("文書の種類") == "選択"]
    if not decls:
        sys.exit(f"宣言が無い: {HOME / 'declarations'}")
    if doc_id:
        return find(decls, doc_id)
    if len(decls) > 1:
        sys.exit("宣言が複数ある。どれかを指す:\n  " + "\n  ".join(d["id"] for d in decls))
    return decls[0]


def 一式(docs, doc_id=None):
    decl = entry(docs, doc_id)
    vals = values_of(decl)
    doc_id = decl.get("id", "?")
    rules = [d for d in docs if d.get("文書の種類") != "選択"]
    print(f"宣言 {doc_id}")
    for k in sorted(vals):
        print(f"  {k:14} {' ・ '.join(sorted(vals[k]))}")
    for kind in KINDS[1:]:
        hit = [d for d in rules if d.get("文書の種類") == kind and fits(d, vals)]
        print(f"\n{kind}　{len(hit)}本")
        for d in hit:
            print(f"  {d['id']:34} {d.get('主題','')}")


def 重なり(docs, args):
    cond = [tuple(x.strip() for x in a.split("=", 1)) for a in args if "=" in a]
    print(f"条件 {dict(cond)} と重なる規約")
    for d in docs:
        if d.get("文書の種類") == "選択":
            continue
        c = dict(d["_cond"])
        if not c or not cond:
            print(f"  {d['id']:34} {c}")
            continue
        shared = set(c) & {k for k, _ in cond}
        if shared and all(c[k] == dict(cond)[k] for k in shared):
            print(f"  {d['id']:34} {c}")


def 差分(docs, change, doc_id=None):
    k, _, v = change.partition("=")
    k, v = k.strip(), v.strip()
    decl = entry(docs, doc_id)
    doc_id = decl.get("id", "?")
    before = values_of(decl)
    after = dict(before, **{k: {v}})
    rules = [d for d in docs if d.get("文書の種類") != "選択"]
    b = {d["id"] for d in rules if fits(d, before)}
    a = {d["id"] for d in rules if fits(d, after)}
    print(f"{doc_id}　{k} を {sorted(before.get(k, []))} → {v}")
    print(f"  効かなくなる {sorted(b - a)}")
    print(f"  新たに効く　 {sorted(a - b)}")
    print(f"  変わらない　 {len(b & a)}本")


def 効かない(docs):
    used = [values_of(d) for d in docs if d.get("文書の種類") == "選択"]
    rules = [d for d in docs if d.get("文書の種類") != "選択"]
    dead = [d for d in rules if not any(fits(d, v) for v in used)]
    print(f"どの宣言にも効かない規約　{len(dead)}本")
    for d in dead:
        print(f"  {d['id']:34} {dict(d['_cond'])}")


def 検査(docs) -> int:
    ax = axes()
    bad: list[str] = []
    # 置き場所は人のためのものだが、種類と食い違っていたら人が迷う。
    # 前置きの種類・置き場所・id の頭の3つが揃っているかを見る。
    if not any(d.get("文書の種類") == "選択" for d in docs):
        bad.append(f"宣言が無い: {HOME / 'declarations'}")
    for d in docs:
        kind0, path = d.get("文書の種類"), d["_path"]
        if kind0 not in KINDS:
            continue
        want = FOLDER_OF[kind0]
        here = path.parent.name if path.parent != HOME else ""
        if here != want:
            bad.append(f"{path.name}: {kind0} は {want}/ に置く（いまは {here or '直下'}）")
        head = PREFIX_OF[kind0]
        if not str(d.get("id", "")).startswith(head):
            bad.append(f"{path.name}: id は {head}- で始める（{kind0} だから）")
    for d in docs:
        name = d["_path"].name
        kind = d.get("文書の種類")
        for key in CORE_KEYS:
            if not d.get(key):
                bad.append(f"{name}: 前置きに {key} が無い")
        if kind not in KINDS:
            bad.append(f"{name}: 文書の種類が {KINDS} のどれでもない（{kind}）")
            continue
        for sec in spine(kind):
            if sec not in d["_sections"]:
                bad.append(f"{name}: 節「{sec}」が無い（{kind} の背骨）")
        if kind == "選択":
            if not values_of(d):
                bad.append(f"{name}: 「この選択がつくる適用条件」から軸の値を読めない")
            for k, vs in values_of(d).items():
                if k not in ax:
                    bad.append(f"{name}: 軸の一覧に無い名前で条件を書いている（{k}）")
                elif len(vs) > 1 and not ax[k]:
                    bad.append(f"{name}: {k} は複数の値をもてない（{sorted(vs)}）")
        else:
            if not d["_cond"]:
                bad.append(f"{name}: 適用条件が無い")
            for k, _ in d["_cond"]:
                if k not in ax:
                    bad.append(f"{name}: 軸の一覧に無い名前で条件を書いている（{k}）")
    if bad:
        print(f"食い違い　{len(bad)}件")
        for b in bad:
            print(f"  {b}")
        return 1
    print(f"文書 {len(docs)}本　食い違いは無い")
    return 0


def 初期化(place: str) -> int:
    """入口と規約の置き場所を作り、宣言の骨をテンプレートから起こす。"""
    home = Path(place)
    if home.exists():
        print(f"{home} はすでにある。何もしない")
        return 1
    home.mkdir(parents=True)
    for sub in FOLDER_OF.values():
        (home / sub).mkdir()
    (home / "declarations" / "declaration-〈名前〉.md").write_text(
        (TPL / "declaration.md").read_text(encoding="utf-8"), encoding="utf-8")
    print(f"{home} を作った")
    for kind, sub in FOLDER_OF.items():
        print(f"  {sub + '/':16}← {kind}")
    print("  declarations/declaration-〈名前〉.md   ← 名前を変えて、軸の値を埋める")
    print()
    print("次にすること")
    print("  1  宣言を書く　　declarations/ の骨に、軸の値を埋める")
    print("  2  規約を書く　　種類に合うテンプレートから起こし、種類のフォルダへ置く")
    print(f"  3  検査する　　　CODING_HOME={home} conv 検査")
    return 0


# ── 描く ────────────────────────────────────────────────

def md2html(text: str) -> str:
    """この Skill の文書が使う書き方だけを、HTML へ写す。

    生の記号を見せるためではなく、**組まれた姿**を見せるために描く。
    外の道具を呼ばない ── このSkillは単体で動く。
    """
    text = re.sub(r"^---\n.*?\n---\n", "", text, flags=re.S)   # 前置きは別に出す
    out: list[str] = []
    rows: list[str] = []
    fence = False
    code: list[str] = []

    def flush_table():
        if not rows:
            return
        head, *body = rows
        cells = [c.strip() for c in head.strip("|").split("|")]
        out.append("<table><tr>" + "".join(f"<th>{inline(c)}</th>" for c in cells) + "</tr>")
        for r in body:
            if set(r.replace("|", "").strip()) <= set("-: "):
                continue
            cs = [c.strip() for c in r.strip("|").split("|")]
            out.append("<tr>" + "".join(f"<td>{inline(c)}</td>" for c in cs) + "</tr>")
        out.append("</table>")
        rows.clear()

    def inline(t: str) -> str:
        t = (t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
        t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
        t = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", t)
        return t

    for line in text.split("\n"):
        if line.startswith("```"):
            if fence:
                out.append("<pre>" + "\n".join(code) + "</pre>")
                code.clear()
            fence = not fence
            continue
        if fence:
            code.append(line.replace("&", "&amp;").replace("<", "&lt;"))
            continue
        if line.startswith("|"):
            rows.append(line)
            continue
        flush_table()
        if m := re.match(r"^(#{1,4}) (.+)$", line):
            n = len(m.group(1))
            out.append(f"<h{n}>{inline(m.group(2))}</h{n}>")
        elif line.startswith("- "):
            out.append(f"<li>{inline(line[2:])}</li>")
        elif line.strip() == "---":
            out.append("<hr>")
        elif line.strip():
            out.append(f"<p>{inline(line)}</p>")
    flush_table()
    return "\n".join(out)


