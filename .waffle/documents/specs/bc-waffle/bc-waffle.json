  "content": {
    "title": {
      "blockType": "Title",
      "title": "スキーマ駆動でDocumentを検証・生成・描画する境界づけられたコンテキスト：bc-waffle"
    },
    "ubiquitousLanguage": {
      "blockType": "UbiquitousLanguage",
      "title": "ユビキタス言語",
      "items": [
        {
          "term": "ドメイン駆動設計",
          "definition": "業務の言葉でモデルを作り、その言葉のまま実装へ運ぶ設計の考え方。この文脈では土台として置く。"
        },
        {
          "term": "境界づけられたコンテキスト",
          "definition": "ある言葉が一貫した意味を持ち続けられる範囲であり、そのモデルが実装として独立している範囲。"
        },
        {
          "term": "業務領域（サブドメイン）",
          "definition": "事業活動を細分化した業務活動の単位。自社で作り込むか既製品に任せるかを判断するための分類を持つ。"
        },
        {
          "term": "集約",
          "definition": "まとめて一貫していなければならない範囲。状態を変える経路を自分の操作だけに絞る。"
        },
        {
          "term": "エンティティ",
          "definition": "同一性を持ち、状態が移り変わっても同じものだと言える構成要素。"
        },
        {
          "term": "値オブジェクト",
          "definition": "同一性を持たず、持つ値だけで等しさが決まる構成要素。"
        },
        {
          "term": "業務サービス",
          "definition": "集約の内側に置けない業務上の計算や判断。状態を持たない。"
        },
        {
          "term": "業務ユースケース",
          "definition": "誰かが目的を持って行う一連の業務。呼び出せる操作を持つ。"
        },
        {
          "term": "不変条件",
          "definition": "集約が操作をまたいで常に満たす業務上の主張。構造の宣言が言えることは、ここへ重ねて書かない。"
        },
        {
          "term": "ユビキタス言語",
          "definition": "境界の内側で、業務に詳しい人と作る人が同じ意味で使う言葉。"
        },
        {
          "term": "腐敗防止層",
          "definition": "外の文脈のモデルをそのまま取り込まず、こちらの言葉へ翻訳して受け取る仕組み。"
        },
        {
          "term": "受け入れ基準",
          "definition": "その要素が満たすべきことを1つの主張として述べたもの。"
        },
        {
          "term": "シナリオ",
          "definition": "受け入れ基準を満たしていると言える、システムを1回通した筋書き。実装へ転写される単位。"
        },
        {
          "term": "転写",
          "definition": "仕様に書かれたシナリオの文言を、そのまま実装側の検証へ写すこと。"
        },
        {
          "term": "照合",
          "definition": "写した文言が食い違っていないかを機械が突き合わせること。"
        },
        {
          "term": "意味的整合",
          "definition": "振る舞いが仕様どおりであること。受け入れ基準とシナリオの転写と照合で担保する。"
        },
        {
          "term": "構造的整合",
          "definition": "在るべきものが在るべき形で在ること。構造の宣言と実物の突き合わせで担保する。"
        },
        {
          "term": "所属",
          "definition": "ある文脈にどの要素が属するかという宣言。欠けと余りを両方向で確かめる。"
        },
        {
          "term": "ドリフト",
          "definition": "宣言と実物が食い違っている状態。食い違っていないかを機械が検知し続ける。"
        },
        {
          "term": "Document",
          "definition": "Schema で構造を定義された JSON の成果物単位。"
        },
        {
          "term": "Schema",
          "definition": "Document の構造・描画・記入と読取の指示を定義するもの。"
        },
        {
          "term": "版",
          "definition": "Schema の世代。一度作った版は遡って構造を変えない。"
        },
        {
          "term": "ブロック",
          "definition": "Document の内容を構成する、意味のまとまりを持つ単位。"
        },
        {
          "term": "意味単位",
          "definition": "ブロック・フィールド・条件一致・全階層など、Document の意味のある取得単位。"
        },
        {
          "term": "骨格(scaffold)",
          "definition": "Schema を機械走査して生成した、値が空の Schema 準拠 Document の雛形。"
        },
        {
          "term": "x-prompt",
          "definition": "Schema に埋め込まれた、書くときと読むときの指針。"
        },
        {
          "term": "描画",
          "definition": "Document を読み手向けの成果物へ整形すること。整形の仕方も Schema が宣言する。"
        },
        {
          "term": "DomainSpecSchema",
          "definition": "業務領域の仕様を定義するもの。文脈・業務領域・業務ユースケース・集約・業務サービスの種別を持つ。"
        },
        {
          "term": "CodingSchema",
          "definition": "実装の在り方を定義するもの。技術構成・概念の配置・層・試験方針を宣言する。"
        },
        {
          "term": "CodingPresets",
          "definition": "実装の在り方の宣言に使う、既定の組み合わせ。"
        },
        {
          "term": "PlatformSpec",
          "definition": "動かす土台の仕様を定義するもの。"
        },
        {
          "term": "PresentationSpecSchema",
          "definition": "画面の設計を定義するもの。"
        },
        {
          "term": "SkillSchema",
          "definition": "Skill を定義するもの。"
        },
        {
          "term": "AgentSchema",
          "definition": "働き手を定義するもの。段取りを担う役と、委ねられる役の両方を扱う。"
        },
        {
          "term": "KnowledgeSchema",
          "definition": "判断の背景となる原則を定義するもの。"
        },
        {
          "term": "HandoffSchema",
          "definition": "決めたことを作る側へ渡す記録を定義するもの。"
        },
        {
          "term": "HookSchema",
          "definition": "自動で割り込む仕掛けを定義するもの。"
        },
        {
          "term": "TemplateSchema",
          "definition": "他へ持ち出すための雛形を定義するもの。"
        },
        {
          "term": "規約",
          "definition": "実装がどう在るべきかの宣言。置き場所・依存の向き・検証の置き方を定める。"
        },
        {
          "term": "概念の配置",
          "definition": "業務領域の構成要素それぞれを、実装のどこに置くかの宣言。"
        },
        {
          "term": "層",
          "definition": "実装を役割で分けた区分。どの層がどの層に依存してよいかを規約が定める。"
        },
        {
          "term": "ポート",
          "definition": "業務の側が定め、外側が実装する境目。"
        },
        {
          "term": "試験方針",
          "definition": "どの層に、どの種類の検証を、どこへ置くかの宣言。"
        },
        {
          "term": "宣言行",
          "definition": "実装側の検証に置かれる、どのシナリオを担うかを名乗る一行。照合の鍵になる。"
        },
        {
          "term": "CLI",
          "definition": "人と道具が、命令を打って Waffle を使う入口。"
        },
        {
          "term": "MCP",
          "definition": "AI の道具として Waffle を使う入口。CLI と同じことができる。"
        },
        {
          "term": "コマンド",
          "definition": "入口から呼べる操作の単位。検証・描画・取得・骨格生成・検知など。"
        },
        {
          "term": "Hooks",
          "definition": "作業の流れの中で、決められた場面に自動で割り込んで働く仕掛け。"
        },
        {
          "term": "Harness",
          "definition": "AI がファイルを直接読まず値だけを埋め、構造への出入りと生成をシステムが担う仕組み。"
        },
        {
          "term": "業務ユースケース駆動設計（UDD）",
          "definition": "業務ユースケースの仕様を正本に置き、そこから実装と検証を導く進め方。"
        },
        {
          "term": "UDDループ",
          "definition": "調べる・決める・引き継ぐ・作るを1周する進め方。どこまで踏むかはその都度判断する。"
        },
        {
          "term": "Orchestrator",
          "definition": "作業の段取りを判断し、専門役へ委ねる役。"
        },
        {
          "term": "Subagent",
          "definition": "Orchestrator が独立した文脈で走らせる働き手。"
        },
        {
          "term": "Skill",
          "definition": "ある作業のやり方を、手順と受け入れ基準の形で持たせたもの。"
        },
        {
          "term": "実務Skill",
          "definition": "調べる・決める・引き継ぐ・作るのそれぞれを担う Skill。"
        },
        {
          "term": "アドバイザーSkill",
          "definition": "ある観点の専門として、判断を敵対的に検証する Skill。"
        },
        {
          "term": "ddd-advisor",
          "definition": "ドメイン駆動設計の観点から検証する役。"
        },
        {
          "term": "tech-lead-advisor",
          "definition": "依存の向き・層の配置・検知の実効性の観点から検証する役。"
        },
        {
          "term": "qa-advisor",
          "definition": "検証の十分さの観点から検証する役。"
        },
        {
          "term": "ux-advisor",
          "definition": "使い手の体験の観点から検証する役。"
        },
        {
          "term": "platform-advisor",
          "definition": "動かす土台の観点から検証する役。"
        },
        {
          "term": "skill-router",
          "definition": "どの実務Skill にどのアドバイザーSkill を組み合わせるかを振り分ける役。"
        },
        {
          "term": "Human on the Loop",
          "definition": "人が担うのは意思決定だけで、それ以外は AI が考え作るという分担。"
        },
        {
          "term": "Knowledge",
          "definition": "判断の背景として繰り返し参照される、採用済みの原則。"
        },
        {
          "term": "ADR",
          "definition": "ある決定について、選択肢と根拠と代償を残した記録。"
        },
        {
          "term": "引き継ぎ",
          "definition": "決めたことを作る側へ渡すための記録。完成の姿と、未解決の論点を含む。"
        },
        {
          "term": "パス",
          "definition": "Document や成果物が置かれている位置。"
        },
        {
          "term": "パステンプレート",
          "definition": "Schema が宣言する、パス変数を含んだ置き場所の型。"
        },
        {
          "term": "実パス",
          "definition": "パス変数がすべて値で埋まった、ひとつに定まるパス。"
        },
        {
          "term": "原本",
          "definition": "値を保持している Document そのもの。"
        },
        {
          "term": "成果物",
          "definition": "Document を描画して得られる、読み手向けの出力。"
        },
        {
          "term": "解決",
          "definition": "パステンプレートとパス変数の値から実パスを導くこと。"
        },
        {
          "term": "逆解析",
          "definition": "実パスとパステンプレートから、パス変数の値を取り出すこと。解決の逆。"
        },
        {
          "term": "パス変数",
          "definition": "パステンプレートの中で、値で埋める箇所。"
        },
        {
          "term": "配り先",
          "definition": "成果物を、原本の置き場所とは別に届ける先。"
        },
        {
          "term": "実装の根",
          "definition": "規約が宣言する、実装ファイルの置き場所の起点。パス変数を含むことがある。"
        },
        {
          "term": "要素の鍵",
          "definition": "配列の中で要素を一意に指す欄。どの欄が鍵かは配列ごとに宣言され、欄の名前は配列によって異なる（id・name・code・term など）。"
        },
        {
          "term": "参照関係の宣言",
          "definition": "ある配列の要素の鍵が、Document のどこから指されるかの宣言。取り下げてよいかの判断と、参照の欠けの検知の両方がここから導かれる。"
        },
        {
          "term": "順序の宣言",
          "definition": "その配列が、要素の集まりではなく並び全体でひとつの値であることの宣言。宣言された配列に要素単位の編集は使えない。"
        },
        {
          "term": "トランザクション",
          "definition": "全部成るか全部成らないかで扱う、ひと塊の変更。実装が何か（保存の呼び出し・ファイルの書き込み・メモリ上の値）は問わない。1つの集約は1つのトランザクションで変更される。"
        },
        {
          "term": "トランザクション境界",
          "definition": "トランザクションとして扱う範囲。どこからどこまでが一度に成るか。不変条件は、依存する変更がこの境界の内側に収まっているときにだけ守られる。"
        },
        {
          "term": "図の宣言",
          "definition": "その図が何を主張し、何を置くかを書いたもの。描き方は書かない——向き・大きさ・並び順・配置は描画側が決める。"
        },
        {
          "term": "主張",
          "definition": "その図が何を言おうとしているかを、定められた語彙のひとつで名指したもの。図はひとつだけ主張を持つ。どの欄を書けてどの欄を書けないかは、主張が決める。"
        },
        {
          "term": "置くもの",
          "definition": "図に現れる要素。子を持てるので木になり、木の深さに上限は無い。ひとつだけ図を持てるので、図の中に図が入る。"
        },
        {
          "term": "つなぐもの",
          "definition": "置くものと置くものの間にある関係。関係の種類や数は記号ではなく言葉で書く——凡例が要る記号は、凡例を持たない読み手に届かない。"
        },
        {
          "term": "読む枠",
          "definition": "置くものを読むための軸や区切り。量を主張する図が持つ。"
        },
        {
          "term": "読み方",
          "definition": "その図をどう読めばよいかを書いた一文。図を描画できない読み手にも意味が届くようにする。"
        },
        {
          "term": "要素への注",
          "definition": "図の特定の要素を名指しして、図からは決められないことを書いたもの。"
        },
        {
          "term": "囲み",
          "definition": "図の中で、いくつかの置くものをひとまとまりとして示すもの。何が1つの塊かは図が示す内容そのもの。"
        }
      ]
    },
